@using RedBug.Models.MasterRecords
@model RedBug.Models.MasterRecords.MasterRecords;
@{
    ViewBag.Title = "Master Records Menu";
    Layout = "_LayoutSideMenu";
}

<div class="container-fluid">
  <div class="row">
    <div class="col-sm-2 border-1 fa-border">
      <div class="d-flex flex-column flex-shrink-0 p-3 bg-light" style="width: 280px;">
        <ul id="listInventory" class="nav nav-pills flex-column mb-auto">
          <li>
            <a class="nav-link link-dark" asp-area="" asp-controller="MasterRecords" asp-action="Lots">
              <span class="fa fa-barcode"></span>
              Lots
            </a>
          </li>
          <li>
            <a class="nav-link link-dark" asp-area="" asp-controller="MasterRecords" asp-action="Items">
              <span class="fa fa-boxes"></span>
              Items
            </a>
          </li>
          <li>
            <a class="nav-link link-dark" asp-area="" asp-controller="MasterRecords" asp-action="ItemStructure">
              <span class="fa fa-building"></span>
              Item Structures
            </a>
          </li>
        </ul>
        <ul id="listCustomers" class="nav nav-pills flex-column mb-auto">
          <li>
            <a class="nav-link link-dark" asp-area="" asp-controller="MasterRecords" asp-action="Customers">
              <span class="fa fa-person"></span>
              Customers
            </a>
          </li>
          <li>
            <a href="#" class="nav-link link-dark">
              <svg class="bi me-2" width="16" height="16"><use xlink:href="#table"/></svg>
              Addresses
            </a>
          </li>
        </ul>
        <ul id="listVendors" class="nav nav-pills flex-column mb-auto">
          <li>
            <a class="nav-link link-dark" asp-area="" asp-controller="MasterRecords" asp-action="Vendors">
              <span class="fa fa-money-bill"></span>
              Vendors
            </a>
          </li>
          <li>
            <a href="#" class="nav-link link-dark">
              <svg class="bi me-2" width="16" height="16"><use xlink:href="#table"/></svg>
              Addresses
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="col border-1 fa-border">
      <div class="card shadow-sm">
        @if (Model.partialView != "" && Model.partialModel != null)
        {
          <partial name="@Model.partialView" model="Model.partialModel"/>
        }
      </div>
    </div>
  </div>
</div>