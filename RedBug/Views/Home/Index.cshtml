@{
    ViewData["Title"] = "Home Page";
    Layout = "_Layout";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <br/>
    <div class="container">
        <div class="row">
            <div class="col col-sm border-dark" id="cAccounting">
                <h4>Accounting</h4>
                <p>
                    Accounting Menus for perfoming functions regarding monetary transactions
                </p>
                @Html.ActionLink("Billing", "Billing", "Menus", null, new { @class = "btn btn-primary" })
                <br/>
                @Html.ActionLink("Accounts Payable", "AccountsPayable", "Menus", null, new { @class = "btn btn-primary" })
            </div>
            <div class="col col-sm border-dark" id="cOrders">
                <h4>Orders</h4>
                <p>
                    Order menus listed such as Shipping, Manufacturing, Transfers, etc
                </p>
                @Html.ActionLink("Manufacturing", "Manufacturing", "Menus", null, new { @class = "btn btn-primary" })
                <br/>
                @Html.ActionLink("Production/Planning", "Production", "Menus", null, new { @class = "btn btn-primary" })
                <br/>
                @Html.ActionLink("Shipping", "Shipping", "Menus", null, new { @class = "btn btn-primary" })
            </div>
            <div class="col col-sm border-dark" id="cReports">
                <h4>Reports</h4>
                <p>
                    Reports for viewing data within the system and for
                    many different parts of the application.
                </p>
                @Html.ActionLink("Reports", "Reports", "Menus", null, new { @class = "btn btn-primary" })
            </div>
        </div>
        <div class="row">
            <div class="col col-sm border-dark" id="cPp">
                <h4>Purchasing & Procurement</h4>    
                <p>
                    Used for the procurement and purchasing of inbound materials, items, services, etc.
                </p>
                @Html.ActionLink("Menu", "PurchasingProcurement", "Menus", null, new { @class = "btn btn-primary" })
            </div>
            <div class="col col-sm border-dark" id="cPf">
                <h4>Planning & Forecasting</h4>    
            </div>
            <div class="col col-sm border-dark" id="cEdi">
                <h4>EDI</h4>    
            </div>
        </div>
    </div>
</div>