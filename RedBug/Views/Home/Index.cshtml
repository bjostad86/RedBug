@{
    ViewData["Title"] = "Home Page";
    Layout = "_Layout";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <br/>
    <div class="container">
        <div class="row">
            <div class="col col-sm border-dark" id="cAccounting">
                <h4>Accounting</h4>
                <p>
                    Accounting Menus for performing functions regarding monetary transactions
                </p>
                @Html.ActionLink("Menu", "Accounting", "Menus", null, new { @class = "btn btn-primary" })
            </div>
            <div class="col col-sm border-dark" id="cOrders">
                <h4>Master Records</h4>
                <p>
                    These are the "master" record maintenance such as lots, customers, vendors, etc
                </p>
                @Html.ActionLink("Menu", "Index", "MasterRecords", null, new { @class = "btn btn-primary" })
            </div>
            <div class="col col-sm border-dark" id="cReports">
                <h4>Reports</h4>
                <p>
                    Reports for viewing data within the system and for
                    many different parts of the application.
                </p>
                @Html.ActionLink("Menu", "Reports", "Menus", null, new { @class = "btn btn-primary" })
            </div>
            <div class="col col-sm border-dark" id="cSecurity">
                <h4>Security</h4>
                <p>
                    Security function menu for managing the security levels and users inside of 
                    this system.
                </p>
                @Html.ActionLink("Menu", "Security", "Menus", null, new { @class = "btn btn-primary" })
            </div>
        </div>
        <br/>
        <div class="row">
            <div class="col col-sm border-dark" id="cPp">
                <h4>Purchasing & Procurement</h4>    
                <p>
                    Used for the procurement and purchasing of inbound materials, items, services, etc.
                </p>
                @Html.ActionLink("Menu", "Index", "Procurement", null, new { @class = "btn btn-primary" })
            </div>
            <div class="col col-sm border-dark" id="cPf">
                <h4>Planning & Forecasting</h4>    
                <p>
                    Menus for production planning and forecasting for production.  
                </p>
                @Html.ActionLink("Menu", "PlanningForecasting", "Menus", null, new { @class = "btn btn-primary" })
            </div>
            <div class="col col-sm border-dark" id="cEdi">
                <h4>EDI</h4>
                <p>
                    Electronic Data Interchange, functionality for processing inbound and outbound transactions
                    that will able to transmit data to trading partners and receive data from trading partners.
                </p>
                @Html.ActionLink("Menu", "Edi", "Menus", null, new { @class = "btn btn-primary" })
            </div>
            <div class="col col-sm border-dark" id="cWarehouse">
                <h4>Warehousing</h4>
                <p>
                    Warehousing Functionality
                </p>
                @Html.ActionLink("Menu", "Warehouse", "Menus", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
</div>