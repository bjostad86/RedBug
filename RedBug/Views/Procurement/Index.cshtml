@using RedBug.Models.Procurement
@model Main
@{
    ViewBag.Title = "Procurement";
    Layout = "_LayoutSideMenu";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-2 border-1 fa-border">
            <div class="d-flex flex-column flex-shrink-0 p-3 bg-light" style="width: 280px;">
                <ul id="listOrders" class="nav nav-pills flex-column mb-auto">
                    <li>
                        <a class="nav-link link-dark" asp-area="" asp-controller="Procurement" asp-action="PurchaseOrders">
                            <span class="fa fa-barcode"></span>
                            Purchase Orders
                        </a>
                        @* <a class="nav-link link-dark" asp-area="" asp-controller="Procurement" asp-action="Receiving"> *@
                        @*     <span class="fa fa-barcode"></span> *@
                        @*     Purchase Orders *@
                        @* </a> *@
                    </li>
                </ul>
                <ul id="listVendors" class="nav nav-pills flex-column mb-auto">
                    <li>
                        <a class="nav-link link-dark" asp-area="" asp-controller="Procurement" asp-action="Vendors">
                            <span class="fa fa-money-bill"></span>
                            Vendors
                        </a>
                    </li>
                    <li>
                        <a class="nav-link link-dark" asp-area="" asp-controller="Procurement" asp-action="VendorTypes">
                            <span class="fa fa-wrench"></span>
                            Vendor Types
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col border-1 fa-border">
            <div class="card shadow-sm">
                @if (Model.partialView != "" && Model.partialModel != null)
                {
                    <partial name="@Model.partialView" model="Model.partialModel"/>
                }
            </div>
        </div>
    </div>
</div>